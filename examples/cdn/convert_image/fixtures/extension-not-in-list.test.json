{
  "appType": "proxy-wasm",
  "description": "Extension gif is not in FORMATS_TO_TRANSFORM list (jpg,png) — app does not schedule conversion",
  "request": {
    "method": "GET",
    "url": "http://fastedge-builtin.debug/animation.gif",
    "headers": {
      "host": "example.com",
      "User-Agent": "Mozilla/5.0 TestBrowser"
    },
    "body": ""
  },
  "response": {
    "headers": {
      "content-type": "image/gif"
    },
    "body": ""
  },
  "properties": {
    "request.extension": "gif"
  },
  "dotenv": {
    "enabled": true,
    "path": "."
  },
  "logLevel": 2,
  "wasm": {
    "path": "<workspace>/.fastedge-debug/app.wasm",
    "description": "Default debugger WASM binary"
  }
}
